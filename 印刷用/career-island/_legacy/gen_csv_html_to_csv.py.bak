#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Squib用CSVを、career-island/career-island-cards.html を直接解析して生成する
(career-islandにはHTML以外の完全なデータソースが無いため。src/data/*.tsは一部の型で
不完全/表記が異なるため使わない)。BOMなしUTF-8で出力する。
"""
import csv
import re
from collections import OrderedDict
from pathlib import Path

from bs4 import BeautifulSoup

SRC = Path(__file__).resolve().parents[2] / "career-island" / "career-island-cards.html"
OUT = Path(__file__).resolve().parent / "data"
OUT.mkdir(parents=True, exist_ok=True)

TYPE_ORDER = ["trouble", "life", "dilemma", "role", "age", "goal",
              "coord", "token", "labor", "learning", "leisure", "love"]


def write_csv(filename, fieldnames, rows):
    path = OUT / filename
    with path.open("w", encoding="utf-8", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)
    print(f"{filename}: {len(rows)} rows")


def text_with_breaks(el):
    """<br>を\nに、それ以外は連結してテキストを取り出す(注釈用の入れ子spanもテキストとして含める)。"""
    if el is None:
        return ""
    return el.get_text("\n", strip=True)


def wrap_after_period(text):
    """句点(。)の直後で改行する(末尾の句点の後には改行を入れない)。"""
    if not text:
        return text
    text = re.sub(r"。(?!\n|$)", "。\n", text)
    return text


def main():
    soup = BeautifulSoup(SRC.read_text(encoding="utf-8"), "html.parser")
    buckets = {t: OrderedDict() for t in TYPE_ORDER}

    for card in soup.select("div.card"):
        classes = card.get("class", [])
        ctype = next((c for c in classes if c in TYPE_ORDER), None)
        if ctype is None:
            continue

        icon = text_with_breaks(card.select_one(".card-icon"))
        badge = text_with_breaks(card.select_one(".card-badge"))
        name = text_with_breaks(card.select_one(".card-name"))
        prompt = text_with_breaks(card.select_one(".card-prompt"))
        effect_label = text_with_breaks(card.select_one(".effect-label"))
        effect_value = text_with_breaks(card.select_one(".effect-value"))
        bonus = text_with_breaks(card.select_one(".card-bonus"))
        setup = text_with_breaks(card.select_one(".card-setup"))

        if ctype == "dilemma":
            opts = card.select(".dilemma-opt")
            opt_a_label = text_with_breaks(opts[0].select_one("b")) if len(opts) > 0 else ""
            opt_a_text = opts[0].get_text(strip=True).replace(opt_a_label, "", 1) if opts else ""
            opt_b_label = text_with_breaks(opts[1].select_one("b")) if len(opts) > 1 else ""
            opt_b_text = opts[1].get_text(strip=True).replace(opt_b_label, "", 1) if len(opts) > 1 else ""
            key = (icon, badge, name, opt_a_label, opt_a_text, opt_b_label, opt_b_text)
        else:
            key = (icon, badge, name, prompt, effect_label, effect_value, bonus, setup)

        buckets[ctype][key] = buckets[ctype].get(key, 0) + 1

    totals = {}

    # --- 汎用型(icon, badge, name, prompt, effect_label, effect_value, bonus, setup) ---
    generic_types = ["trouble", "life", "role", "age", "goal", "token",
                      "labor", "learning", "leisure", "love"]
    for ctype in generic_types:
        rows = []
        for (icon, badge, name, prompt, effect_label, effect_value, bonus, setup), count in buckets[ctype].items():
            rows.append({
                "icon": icon, "badge": badge, "name": name, "prompt": prompt,
                "effect_label": effect_label, "effect_value": wrap_after_period(effect_value),
                "bonus": bonus, "setup": setup, "Copies": count,
            })
        write_csv(f"{ctype}.csv",
                   ["icon", "badge", "name", "prompt", "effect_label", "effect_value", "bonus", "setup", "Copies"],
                   rows)
        totals[ctype] = sum(r["Copies"] for r in rows)

    # --- dilemma ---
    rows = []
    for (icon, badge, name, a_label, a_text, b_label, b_text), count in buckets["dilemma"].items():
        rows.append({
            "icon": icon, "badge": badge, "name": name,
            "opt_a_label": a_label, "opt_a_text": a_text,
            "opt_b_label": b_label, "opt_b_text": b_text, "Copies": count,
        })
    write_csv("dilemma.csv",
               ["icon", "badge", "name", "opt_a_label", "opt_a_text", "opt_b_label", "opt_b_text", "Copies"],
               rows)
    totals["dilemma"] = sum(r["Copies"] for r in rows)

    # --- coord_draw: 抽選用に、横列(A-E)×縦列(1-5)を組み合わせた25枚を合成する。
    # (HTMLには存在しない新設計。個別の横列/縦列カードではなくA-1〜E-5の完成済み座標として引く)
    rows = [{"label": f"{letter}-{num}", "Copies": 1}
            for letter in "ABCDE" for num in range(1, 6)]
    write_csv("coord_draw.csv", ["label", "Copies"], rows)
    totals["coord"] = len(rows)

    print("\ntotals:")
    for t in TYPE_ORDER:
        print(f"  {t}: {totals[t]}")
    print(f"  grand total: {sum(totals.values())}")


if __name__ == "__main__":
    main()
